# Copy to .streamlit/secrets.toml locally (git-ignored), or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Uses the READ-ONLY app user.
[snowflake]
account = "ORGNAME-ACCOUNTNAME"   # Snowsight -> account menu -> Connect a tool -> Account identifier
user = "SHORTAGE_APP"
role = "SHORTAGE_READER"
warehouse = "SHORTAGE_WH"
database = "MEMORY_SHORTAGE"
schema = "MARTS"
login_timeout = 10
private_key = """-----BEGIN PRIVATE KEY-----
...contents of keys/shortage_app_key.p8...
-----END PRIVATE KEY-----"""
